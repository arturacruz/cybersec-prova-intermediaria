{
  "manifest_version": 3,
  "name": "Oceania",
  "version": "1.0.0",

  "description": "Browser extension that detects attacks, trackers and privacy violations.",

  "icons": {
    "48": "icons/oceania-48.png",
    "96": "icons/oceania-96.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "oceania@insper.com"
    }
  },

  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "webRequest"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background/background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/oceania.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_title": "Oceania",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/oceania-48.png",
      "96": "icons/oceania-96.png"
    }
  }
}
