{
  "manifest_version": 3,
  "name": "Oceania",
  "version": "0.1",

  "description": "Browser extension that detects attacks, trackers and privacy violations.",

  "icons": {
    "48": "icons/oceania-48.png",
    "96": "icons/oceania-96.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "oceania@insper.com"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/oceania.js"]
    }
  ],

  "action": {
    "default_title": "Oceania",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/oceania-48.png",
      "96": "icons/oceania-96.png"
    }
  }
}
